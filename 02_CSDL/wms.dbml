// PostgreSQL-specific partial/NULLS NOT DISTINCT indexes and triggers are in 001_schema.sql.
TableGroup master {
  organization
  warehouse
  location
  uom
  product_category
  product
  product_uom
  barcode
  partner
  reference_price
  product_image
}
TableGroup iam {
  app_user
  role
  permission
  role_permission
  user_role_grant
  auth_session
  mfa_factor
}
TableGroup inventory {
  lot
  serial
  stock_item
  inventory_transaction
  stock_move
  stock_balance
  serial_position
}
TableGroup documents {
  document
  document_line
  document_link
  document_assignment
  document_attachment
}
TableGroup fulfillment {
  reservation
  pick_task
  reservation_consumption
  package
  package_line
  quality_decision
}
TableGroup approval {
  approval_policy
  approval_policy_step
  approval_request
  approval_step
}
TableGroup counting {
  stock_period
  count_session
  count_location_lock
  count_assignment
  count_line
  count_observation
}
TableGroup operations {
  idempotency_record
  outbox_event
  consumer_receipt
  audit_event
  stored_file
  import_job
  import_row
  export_job
}
TableGroup extension {
  custom_field_definition
  client_release
}