# Literal KEY=value, no quotes, export or interpolation. root:root 0644.
KWS_DATABASE_URL=postgresql+psycopg://wms_app@/kws?host=/var/run/postgresql
KWS_HOST=127.0.0.1
KWS_PORT=8000
KWS_POOL_SIZE=3
KWS_DATABASE_TIMEOUT_SECONDS=30
KWS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
KWS_EXPORT_STORAGE_ROOT=/srv/kws/export
KWS_PRINT_STORAGE_ROOT=/srv/kws/print
# KWS_PRINT_ISSUER_NAME=<configure>
# KWS_PRINT_ISSUER_ADDRESS=<configure>
# KWS_PRINT_ISSUER_TAX_CODE=<configure>
# KWS_PRINT_ISSUER_PHONE=<configure>
# KWS_PRINT_ISSUER_SIGNER=<configure>
KWS_OUTBOX_CONSUMER_FACTORY=apps.server.consumers.registry:consumer_factory
KWS_OUTBOX_MAX_ATTEMPTS=5
KWS_OUTBOX_BATCH_SIZE=100
KWS_OUTBOX_POLL_SECONDS=1
KWS_OUTBOX_BACKOFF_BASE_SECONDS=5
KWS_OUTBOX_BACKOFF_MAX_SECONDS=300
KWS_EXPORT_LEASE_SECONDS=300
KWS_PRINT_LEASE_SECONDS=300
KWS_EXPORT_MAX_ATTEMPTS=5
KWS_PRINT_MAX_ATTEMPTS=5
