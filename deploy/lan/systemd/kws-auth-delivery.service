[Unit]
Description=KWS email and SMS authentication delivery
Requires=postgresql@16-main.service
After=postgresql@16-main.service
PartOf=kws.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kws
Group=kws
WorkingDirectory=/opt/kws/current
LoadCredential=mfa.env:/etc/kws/mfa.env
LoadCredential=auth.env:/etc/kws/auth.env
ExecStart=/opt/kws/current/venv/bin/python -I /opt/kws/current/lan_runtime.py auth-delivery
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
LimitCORE=0
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kws-auth-delivery

[Install]
WantedBy=kws.target
