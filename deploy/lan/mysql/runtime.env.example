# Copy to a private mode-0600 environment file and replace placeholders.
# The desktop uses the API URL, never database credentials.
KWS_DATABASE_URL=mysql+pymysql://APP_USER:URL_ENCODED_PASSWORD@localhost/kws_mysql?unix_socket=/var/run/mysqld/mysqld.sock&charset=utf8mb4
KWS_HOST=127.0.0.1
KWS_PORT=8001
KWS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
