# Local development only. Set the user/password through your environment.
# The server never reads this file automatically. Export KWS_DATABASE_URL first.
KWS_DATABASE_URL=postgresql+psycopg://kws_dev@localhost:5432/kws_dev
KWS_HOST=127.0.0.1
KWS_PORT=8000
# Required to enroll/use MFA; generate once and keep outside Git, backed up separately.
# KWS_MFA_ENCRYPTION_KEY=<Fernet key generated by the operator>
KWS_ACCESS_TTL_SECONDS=900
KWS_SESSION_TTL_SECONDS=28800
KWS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Desktop accepts plain HTTP only on loopback for development.
KWS_API_URL=http://127.0.0.1:8000/api/v1
# For LAN: https://wms.example.internal/api/v1
# KWS_CA_FILE=/path/to/internal-ca.crt
# Optional desktop local directory; keep device.sqlite3 and receipts/ across upgrades.
# Default: %LOCALAPPDATA%/kws-lan on Windows, $XDG_DATA_HOME/kws-lan or ~/.local/share/kws-lan on Linux.
# Use a local disk, not a network share. No password/access/refresh token is stored here.
# KWS_LOCAL_DATA_DIR=/path/to/local/kws-lan
